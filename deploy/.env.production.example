# Copy to VPS as .env next to docker-compose.yml (never commit real secrets)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
JWT_SECRET=change_me_long_random_secret_at_least_32_chars
GEMINI_API_KEY=your_gemini_key

# Optional: if images are under your Docker Hub namespace
# COMPOSE already uses job-portal/... locally; on VPS use pull from Docker Hub tags you pushed
